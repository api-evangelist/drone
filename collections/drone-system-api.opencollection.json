{
  "opencollection": "1.0.0",
  "info": {
    "name": "Drone REST Builds System API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get system version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-drone-server/version"
          },
          "docs": "Returns Drone server version information."
        }
      ]
    }
  ],
  "bundled": true
}